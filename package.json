{
  "name": "@peter.naydenov/dom-selector",
  "description": "DOM selections and DOM references organizer",
  "version": "3.1.8",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./src/main.js",
  "type": "module",
  "types": "./types/main.d.ts",
  "files": [
    "dist",
    "src",
    "types",
    "skills"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./types/main.d.ts",
        "default": "./src/main.js"
      },
      "require": {
        "types": "./types/main.d.cts",
        "default": "./dist/dom-selector.cjs"
      },
      "default": {
        "types": "./types/main.d.ts",
        "default": "./src/main.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "tsc -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "cover": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/dom-selector.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.4",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "dom",
    "select",
    "html",
    "scan",
    "mavis",
    "ai",
    "agent-skill"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
